{
  "name": "qa-svelte",
  "private": true,
  "version": "0.0.1",
  "packageManager": "bun@1.4.1",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "composer:deploy": "prisma deploy module.ts",
    "composer:dev": "prisma dev module.ts",
    "contract:emit": "prisma contract emit",
    "db:init": "prisma db init",
    "db:update": "prisma db update",
    "db:verify": "prisma db verify",
    "deploy": "bun run build && bun run composer:deploy",
    "dev": "vite dev",
    "dev:composer": "bun run build && bun run composer:dev",
    "migrate": "prisma db migrate",
    "migration:plan": "prisma migration plan",
    "migration:show": "prisma migration show",
    "migration:status": "prisma migration status",
    "prepare": "svelte-kit sync || echo ''",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@prisma/dev": "0.25.2",
    "@sveltejs/adapter-node": "^5.3.2",
    "@sveltejs/kit": "^2.50.2",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@types/node": "^25.6.2",
    "prisma": "8.0.0-rc.17",
    "svelte": "^5.51.0",
    "svelte-check": "^4.4.2",
    "tsx": "^4.7.1",
    "typescript": "^5.9.3",
    "vite": "^8.1.2"
  },
  "dependencies": {
    "@prisma/composer": "0.23.0",
    "@prisma/composer-prisma-cloud": "0.23.0",
    "@prisma/orm-postgres": "8.0.0-rc.12",
    "alchemy": "2.0.0-beta.78",
    "temporal-polyfill": "^1.0.4"
  },
  "overrides": {
    "effect": "4.0.0-rc.115"
  }
}
